# ooblivion environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Container image deployed by docker-compose.yml.
# Defaults to latest; pin a release tag to match the version shown in the UI:
#   OOB_IMAGE=ghcr.io/its0din-ai/ooblivion:v1.6
# OOB_IMAGE=ghcr.io/its0din-ai/ooblivion:latest

# Single HTTP listener address (capture + admin).
# Local run:   127.0.0.1:8082
# Docker:      :8080 (container overrides this in docker-compose.yml)
OOB_LISTEN_ADDR=:8080

# Comma-separated hostnames allowed to reach /admin/** (empty = any host).
# Behind a reverse proxy set this to the PUBLIC admin domain, e.g.
#   ADMIN_HOST=ooblivion.acme.corp
# (the Host header seen by the app is the proxy hostname, not 127.0.0.1).
# All other hosts get captured + 200 empty on /admin/**, incl. X-Forwarded-Host.
ADMIN_HOST=

# SQLite database path.
# Local run:   data/ooblivion.db
# Docker:      /app/data/ooblivion.db (container overrides this; volume is persistent)
DATABASE_PATH=data/ooblivion.db

# JWT HS512 signing secret — must be at least 64 bytes
JWT_SECRET=

# Initial admin password (min 16 chars). Used only on first boot.
ADMIN_PASSWORD=

# Telegram bot token (optional; empty disables notifications)
TELEGRAM_BOT_TOKEN=

# Telegram chat id to receive alerts (optional; lives in .env, not the UI)
TELEGRAM_CHAT_ID=

# Telegram topic/thread id within the chat (optional; for supergroups with
# topics enabled, sends alerts into that thread instead of the general chat)
TELEGRAM_THREAD_ID=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Shared secret for the container healthcheck. docker-compose.yml sends it as the
# X-Health-Check header on GET /healthz; only requests carrying this exact value
# are answered 200 and skipped from capture. Every other /healthz request is
# recorded like a normal request. Generate with: openssl rand -hex 16
# Leave empty to disable the bypass entirely.
HEALTH_CHECK_SECRET=

# Capture body size cap in bytes (default 1 MB)
MAX_BODY_BYTES=1048576
